<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- "Leia para mim": o áudio longo é gerado num serviço em primeiro plano do tipo
       dataSync (transferência de rede), que segue com a tela apagada e o app fora
       da tela — o JavaScript congela nesses casos. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.readaloudaudio.ReadAloudService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
  </application>
</manifest>
